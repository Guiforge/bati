{
  "dependencies": {
    "@expo-google-fonts/alegreya": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@legendapp/list": "^3.6.0",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@scure/bip39": "^2.4.0",
    "@tamagui/animations-react-native": "3.1.6",
    "@tamagui/config": "3.1.6",
    "@tamagui/lucide-icons": "^1.144.4",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.5.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.2",
    "react-native": "0.88.0",
    "react-native-android-widget": "^0.23.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tamagui": "3.1.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@biomejs/biome": "^2.6.2",
    "@j178/prek": "^0.5.7",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~58.0.19",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "expo-dev-client": "~58.0.16",
    "jest": "30.5.2",
    "jest-expo": "~58.0.12",
    "knip": "^6.42.1",
    "typescript": "~7.0.2"
  },
  "jest": {
    "maxWorkers": "25%",
    "workerIdleMemoryLimit": "1GB",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver.js",
    "transform": {
      "\\.mjs$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|tamagui|@tamagui|@legendapp|@scure|@noble))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testMatch": [
      "**/__tests__/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/worktrees/"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/node_modules/**",
      "!**/.claude/**",
      "!test/**",
      "!.design-sync/**",
      "!**/__tests__/**",
      "!**/.expo/**",
      "!**/coverage/**",
      "!**/*.d.ts",
      "!babel.config.js",
      "!drizzle.config.ts",
      "!tamagui.config.ts",
      "!db/schema.ts",
      "!jest.setup.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 100,
        "statements": 100,
        "branches": 0,
        "functions": 0
      },
      "./app/": {
        "lines": 15,
        "branches": 13,
        "functions": 10
      },
      "./components/": {
        "lines": 36,
        "branches": 31,
        "functions": 32
      },
      "./src/": {
        "lines": 81,
        "branches": 61,
        "functions": 73
      },
      "./db/": {
        "lines": 85,
        "branches": 72,
        "functions": 84
      },
      "./hooks/": {
        "lines": 86,
        "branches": 73,
        "functions": 69
      },
      "./stores/": {
        "lines": 91,
        "branches": 78,
        "functions": 80
      },
      "./constants/": {
        "lines": 93,
        "branches": 75,
        "functions": 88
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "main": "index.ts",
  "name": "bati",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "android:release": "cd android && ./gradlew installRelease -PbatiLocalId=.perf -PreactNativeArchitectures=arm64-v8a",
    "audit:shots": "bash scripts/audit-shots.sh",
    "check": "biome check --write --error-on-warnings . && npx tsc -p tsconfig.json --noEmit",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "deadcode": "knip",
    "format": "biome check --write .",
    "ios": "expo run:ios",
    "licenses": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-licenses.mjs",
    "maestro": "bash scripts/maestro.sh",
    "postinstall": "node scripts/strip-play-services.mjs",
    "prepare": "prek install",
    "release": "bash scripts/release.sh",
    "screenshots": "bash scripts/screenshots.sh",
    "start": "expo start",
    "test": "jest",
    "test:watch": "jest --watch",
    "web": "expo start --web"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "brace-expansion@^5.0.8": "5.0.12",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "@tamagui/lucide-icons": {
      "@tamagui/core": "3.1.2",
      "@tamagui/helpers-icon": "3.1.2"
    },
    "@tamagui/web": "3.1.2",
    "react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "jest-environment-node": "30.4.1",
    "jest-environment-jsdom": "30.4.1"
  },
  "version": "2.13.1",
  "license": "MIT",
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        ".*"
      ]
    },
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "typescript"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
