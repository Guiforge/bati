{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guiforge.bati"
    },
    "backgroundColor": "#0B0F19",
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.guiforge.bati"
    },
    "locales": {
      "en": "./locales/ios/en.json",
      "fr": "./locales/ios/fr.json"
    },
    "name": "Bati",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F19",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "fr"],
            "android": ["en", "fr"]
          }
        }
      ],
      "expo-router",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to pick a photo as your hero's avatar. The image stays on your device and is never uploaded."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Flame",
              "label": "Bati — Flame",
              "description": "Your current training streak.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withAndroidLintExtraTranslation",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidGradleMemory",
      "./plugins/withAndroidTrimPermissions"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "bati",
    "slug": "bati",
    "userInterfaceStyle": "dark",
    "version": "1.0.2",
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    }
  }
}
