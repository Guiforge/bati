# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
node_modules

# Expo
.expo/
dist/
web-build/

# Gradle output for local Expo modules. android/.gitignore covers android/build, but a module
# under modules/ builds into its own tree and nothing was watching that one — 97 files of R.jar
# and merged manifests walked into the first commit that added one.
modules/*/android/build/
coverage/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
# Signing keys. The release keystore is the one file whose loss is unrecoverable: Android will
# not install an update signed by a different key, so losing it ends updates to the published app
# for good. Keep it backed up outside this repository, and never in it.
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Environment variables - NEVER commit sensitive data
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets (CRITICAL - NEVER commit)
secrets/
.secrets/
private/
credentials.json
*.pem
*.pass
.env.production.local
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders (android/ is committed for the F-Droid subdir check,
# but still regenerated by `expo prebuild --clean` at build time)
/ios


.impeccable

# Raw device captures: an input to the store shots, not an artefact worth versioning.
fastlane/raw*/
.gbrain-source

# Personal GPS traces and screenshots used to tune the expedition maths by hand. Real outings,
# not fixtures: they stay on the machine that recorded them.
test-gpx/

# UX audit screenshots, throwaway by design
.audit/

# Pose reference pictures live in a private repo (~/.cache/bati-art-loop/pose-refs): some are photos of the maintainer.
scripts/pose-refs/*.png

# design-sync (claude.ai/design): staged converter, regenerable bundle and machine state.
# .design-sync/{config.json,NOTES.md,conventions.md,previews,docs,web} are the committed inputs.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Thronebreaker mood screenshots for the village loop: never committed, never sent to FLUX.
moodboard/
docs/designs/village-loop/iter-*/frames/
docs/designs/village-loop/iter-*/*-planche.png

# WorkBuddy agent state (session memory, not project data)
.workbuddy/

# village-buildings: maquette PNGs, explorations, baselines and per-round captures stay local (F-Droid clones the history); texts, report.json and the two r3 strips stay tracked.
docs/designs/village-buildings/explore/
docs/designs/village-buildings/baseline/
docs/designs/village-buildings/*/concepts/*
!docs/designs/village-buildings/*/concepts/board.phone.*
docs/designs/village-buildings/calibration/*.png
docs/designs/village-buildings/*/r[0-9]*/*
!docs/designs/village-buildings/maquettes/r*/g-id.md
!docs/designs/village-buildings/maquettes/r*/report.json
!docs/designs/village-buildings/maquettes/r*/footprint.txt
!docs/designs/village-buildings/maquettes/r3/strip_windmill.png
!docs/designs/village-buildings/maquettes/r3/strip_observatory.png

# Capture sets of the village iso tracks stay local, archived in ~/bati-archives/ (F-Droid clones this repo)
docs/designs/village-iso-v1/evidence/
docs/designs/village-loop/evidence/
docs/designs/village-loop/iter-00/
docs/designs/village-loop/iter-*-captures*/
docs/designs/village-loop/vue-ensemble/
docs/designs/village-loop/build.log
docs/designs/village-loop/loupes/baseline/
docs/designs/village-loop/loupes/**/captures*/
docs/designs/village-loop/loupes/**/sondes*/
docs/designs/village-loop/loupes/**/*.png
docs/designs/village-loop/loupes/**/*.webp
!docs/designs/village-loop/loupes/bc/r6/bc-*.png
docs/designs/village-surroundings/**/*.png
docs/designs/village-surroundings/**/*.webp
docs/designs/village-buildings/baseline-wrong/
docs/designs/village-buildings/verif-coin/
docs/designs/village-buildings/calibration/**/*.png
.claude/settings.local.json.v1-bak
docs/designs/village-buildings/*/final/*
!docs/designs/village-buildings/*/final/strip.png
