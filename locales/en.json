  "safety": {
    "title": "Train safely",
    "before_title": "Before you start",
    "before_body": "If you are pregnant, recovering from an injury or surgery, live with a heart, joint or blood-pressure condition, or have been inactive for a long time, talk to a doctor before starting this or any training programme.",
    "during_title": "While you train",
    "during_body": "Sharp pain is not effort — stop. Dizziness, chest pain or shortness of breath mean stop and seek medical advice. Every target here is a suggestion: end a set with a rep or two left in you rather than chasing a number with broken form.",
    "not_a_coach_title": "Bati is not a coach",
    "not_a_coach_body": "This app counts what you do and tells a story about it. It cannot see your technique, and it is not medical advice. For a diagnosis, an injury or a plan built around your body, see a qualified professional.",
    "onboarding_line": "Train within your limits. If you have a health condition, an injury, or you are pregnant, talk to a doctor first.",
    "read_more": "Read the safety notice"
  },
  "privacy": {
    "title": "Privacy",
    "summary": "Bati collects nothing. Nothing you do in this app leaves your phone unless you send it yourself, deliberately, by email.",
    "storage_title": "Where your training lives",
    "storage_body": "Every session, set, quest, adventure, achievement and setting is written to a database inside this app's private storage on your device. It is never uploaded and never synced. There is no server to upload it to, and no account to attach it to. Deleting the app deletes all of it.",
    "never_title": "What Bati never does",
    "never_body": "No account, no sign-up, no analytics, no telemetry, no advertising, no tracking identifiers, and no third-party SDK that collects anything. The app makes no network requests at all, at any point.",
    "permissions_title": "Permissions",
    "permissions_body": "Photos: only if you pick one as your avatar — it stays on your device. The Android widget reads your streak from the same local database. The app sends no notifications at all.",
    "crashes_title": "Crash reports",
    "crashes_body": "If the app crashes, the error is written to your device only. Nothing is sent automatically. \"Report a bug\" below opens your own email app with the report filled in, so you can read it, edit it or delete it before sending. If you never send it, it never leaves your phone.",
    "children_title": "Children",
    "children_body": "Bati is a general-audience fitness app and is not directed at children under 13. It collects no personal data from anyone, of any age.",
    "contact_title": "Questions",
    "contact_body": "Write to feedback.bati@proton.me — for this policy, and for a bug, an idea, or a feature you wish existed. Since the app holds no data about you, there is nothing for us to export or delete on your behalf: uninstalling erases every record it ever made.",
    "updated": "Last updated 31 July 2026"
  },
