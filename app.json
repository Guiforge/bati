{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101323",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guiforge.bati"
    },
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.guiforge.bati"
    },
    "name": "bati",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101323",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "fr"],
            "android": ["en", "fr"]
          }
        }
      ],
      "expo-router",
      "expo-audio",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Utilisée pour choisir une photo comme avatar."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Flame",
              "label": "Bati — Flame",
              "description": "Your current training streak.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "bati",
    "slug": "bati",
    "userInterfaceStyle": "dark",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    }
  }
}
