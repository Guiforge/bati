{
  "dependencies": {
    "@legendapp/list": "^3.3.3",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/elements": "^2.9.36",
    "@react-navigation/native": "^7.3.14",
    "@tamagui/animations-react-native": "^2.6.0",
    "@tamagui/config": "^2.6.0",
    "@tamagui/lucide-icons": "^1.144.4",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "57",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@j178/prek": "^0.4.11",
    "@tamagui/babel-plugin": "^2.6.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.17",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.5",
    "better-sqlite3": "^13.0.2",
    "drizzle-kit": "^0.31.10",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.(spec|test).(js|jsx|ts|tsx)"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/node_modules/**",
      "!**/__tests__/**",
      "!**/.expo/**",
      "!**/coverage/**",
      "!**/*.d.ts",
      "!babel.config.js",
      "!drizzle.config.ts",
      "!tamagui.config.ts",
      "!db/schema.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 30,
        "functions": 29,
        "lines": 39,
        "statements": 38
      }
    },
    "collectCoverage": true
  },
  "main": "expo-router/entry",
  "name": "bati",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "check": "biome check --write . && npx tsc -p tsconfig.json --noEmit",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "format": "biome check --write .",
    "ios": "expo run:ios",
    "maestro": "bash scripts/maestro.sh",
    "prepare": "prek install",
    "start": "expo start",
    "test": "jest",
    "test:watch": "jest --watch",
    "web": "expo start --web"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true
  },
  "version": "1.0.0"
}
