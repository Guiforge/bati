{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.expo",
      "!**/.tamagui",
      "!**/dist",
      "!**/node_modules",
      "!**/babel.config.js",
      "!**/metro.config.js",
      "!assets",
      "!.claude",
      "!.github",
      "!docs/legal/**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false
    },
    "globals": ["__DEV__"]
  },
  "plugins": [
    "./.biome/plugins/noRawHexColor.grit",
    "./.biome/plugins/noIdenticalTernaryArms.grit"
  ],
  "linter": {
    "enabled": true,
    "domains": {
      "react": "all",
      "reactNative": "all",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noVoid": "error",
        "noUselessFragments": "error",
        "noExtraBooleanCast": "error",
        "noForEach": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noConstantCondition": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredVariables": "error",
        "noSelfAssign": "error",
        "noVoidTypeReturn": "error"
      },
      "style": {
        "useImportType": "off",
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useTemplate": "error",
        "noParameterAssign": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noArrayIndexKey": "error",
        "noDuplicateJsxProps": "error",
        "noAssignInExpressions": "error",
        "noImplicitAnyLet": "error",
        "noRedeclare": "error",
        "useAwait": "warn",
        "noEmptyBlockStatements": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["components/HomeSettingsMenu.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["components/village/VillageScene.tsx", "db/village.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.md"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/__tests__/**"],
      "javascript": {
        "globals": ["jest"]
      },
      "linter": {
        "domains": {
          "test": "all"
        },
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noEmptyBlockStatements": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
