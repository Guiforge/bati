{
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/list": "^2.0.19",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/elements": "^2.9.3",
    "@react-navigation/native": "^7.1.26",
    "@tamagui/animations-react-native": "^1.142.0",
    "@tamagui/config": "^1.142.0",
    "@tamagui/lucide-icons": "^1.142.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "expo": "57",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "i18next": "^25.7.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.1",
    "react-native": "0.86.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.0",
    "tamagui": "^1.142.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tamagui/babel-plugin": "^1.142.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.8",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.(spec|test).(js|jsx|ts|tsx)"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/node_modules/**",
      "!**/__tests__/**",
      "!**/.expo/**",
      "!**/coverage/**",
      "!**/*.d.ts",
      "!babel.config.js",
      "!drizzle.config.ts",
      "!tamagui.config.ts",
      "!db/schema.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 25,
        "functions": 23,
        "lines": 32,
        "statements": 31
      }
    },
    "collectCoverage": true
  },
  "main": "expo-router/entry",
  "name": "bati",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "check": "biome check --write . && npx tsc -p tsconfig.json --noEmit",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "format": "biome check --write .",
    "ios": "expo run:ios",
    "prepare": "husky",
    "start": "expo start",
    "test": "jest",
    "test:watch": "jest --watch",
    "web": "expo start --web"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "overrides": {
    "@tamagui/portal": "1.144.4"
  },
  "version": "1.0.0"
}
