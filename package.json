{
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.14",
    "@legendapp/list": "^3.3.8",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/elements": "^2.9.39",
    "@react-navigation/native": "^7.3.17",
    "@tamagui/animations-react-native": "^2.7.7",
    "@tamagui/config": "^2.7.7",
    "@tamagui/lucide-icons": "^1.144.4",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.15",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "i18next": "^26.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@j178/prek": "^0.5.0",
    "@tamagui/babel-plugin": "^2.7.7",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.18",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "expo-dev-client": "~57.0.16",
    "jest": "30.4.1",
    "jest-expo": "~57.0.5",
    "knip": "^6.32.2",
    "typescript": "~7.0.2"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|tamagui|@tamagui|@legendapp))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testMatch": [
      "**/__tests__/**/*.(spec|test).(js|jsx|ts|tsx)"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/node_modules/**",
      "!**/__tests__/**",
      "!**/.expo/**",
      "!**/coverage/**",
      "!**/*.d.ts",
      "!babel.config.js",
      "!drizzle.config.ts",
      "!tamagui.config.ts",
      "!db/schema.ts",
      "!jest.setup.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 100,
        "statements": 100,
        "branches": 0,
        "functions": 0
      },
      "./app/": {
        "lines": 15,
        "branches": 13,
        "functions": 10
      },
      "./components/": {
        "lines": 36,
        "branches": 31,
        "functions": 32
      },
      "./src/": {
        "lines": 81,
        "branches": 61,
        "functions": 73
      },
      "./db/": {
        "lines": 85,
        "branches": 72,
        "functions": 84
      },
      "./hooks/": {
        "lines": 86,
        "branches": 73,
        "functions": 69
      },
      "./stores/": {
        "lines": 91,
        "branches": 78,
        "functions": 80
      },
      "./constants/": {
        "lines": 93,
        "branches": 75,
        "functions": 88
      }
    },
    "collectCoverage": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "main": "index.ts",
  "name": "bati",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "android:release": "cd android && ./gradlew installRelease -PbatiLocalId=.perf -PreactNativeArchitectures=arm64-v8a",
    "check": "biome check --write --error-on-warnings . && npx tsc -p tsconfig.json --noEmit",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "deadcode": "knip",
    "format": "biome check --write .",
    "ios": "expo run:ios",
    "maestro": "bash scripts/maestro.sh",
    "prepare": "prek install",
    "release": "bash scripts/release.sh",
    "screenshots": "bash scripts/screenshots.sh",
    "start": "expo start",
    "test": "jest",
    "test:watch": "jest --watch",
    "web": "expo start --web"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "brace-expansion@^5.0.8": "5.0.9",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "@tamagui/lucide-icons": {
      "@tamagui/core": "2.7.7",
      "@tamagui/helpers-icon": "2.7.7"
    },
    "@tamagui/web": "2.7.7",
    "react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "jest-environment-node": "30.4.1",
    "jest-environment-jsdom": "30.4.1"
  },
  "version": "1.13.0",
  "license": "MIT",
  "expo": {
    "autolinking": {
      "buildFromSource": [
        ".*"
      ]
    },
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "typescript"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
