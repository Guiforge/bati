# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Gradle output for local Expo modules. android/.gitignore covers android/build, but a module
# under modules/ builds into its own tree and nothing was watching that one — 97 files of R.jar
# and merged manifests walked into the first commit that added one.
modules/*/android/build/
coverage/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
# Signing keys. The release keystore is the one file whose loss is unrecoverable: Android will
# not install an update signed by a different key, so losing it ends updates to the published app
# for good. Keep it backed up outside this repository, and never in it.
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Environment variables - NEVER commit sensitive data
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets (CRITICAL - NEVER commit)
secrets/
.secrets/
private/
credentials.json
*.pem
*.pass
.env.production.local
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders (android/ is committed for the F-Droid subdir check,
# but still regenerated by `expo prebuild --clean` at build time)
/ios


.impeccable

# Raw device captures: an input to the store shots, not an artefact worth versioning.
fastlane/raw*/
.gbrain-source
