# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
coverage/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
# Signing keys. The release keystore is the one file whose loss is unrecoverable: Android will
# not install an update signed by a different key, so losing it ends updates to the published app
# for good. Keep it backed up outside this repository, and never in it.
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Environment variables - NEVER commit sensitive data
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets (CRITICAL - NEVER commit)
secrets/
.secrets/
private/
credentials.json
*.pem
*.pass
.env.production.local
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android


.impeccable
