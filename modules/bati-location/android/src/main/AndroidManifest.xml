<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The permission bill for Google-free GPS, declared here rather than in app.json so it
      travels with the module that needs it: delete the module, and the app's install screen
      goes back to what it was.

      Each one is earned by BatiLocationService below: FINE and COARSE for the fixes (the pair
      because API 31 refuses a FINE-only runtime request), FOREGROUND_SERVICE and its typed
      half for a service that outlives the screen going off, WAKE_LOCK for the session, and
      POST_NOTIFICATIONS because from API 33 the foreground-service notification is invisible
      without it. Each is justified again, in prose, in __tests__/android-permissions.test.ts.

      See docs/designs/gps-without-google.md.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application>
        <!--
          Fully qualified on purpose: a leading dot in a library manifest resolves against the
          *merged* package, which is the app's, and would name a class that does not exist.
        -->
        <!--
          stopWithTask, because a swipe out of recents takes the JS runtime with it: nothing is
          left to receive a fix or write one down, and what stayed behind was 1 Hz of GPS and a
          PARTIAL_WAKE_LOCK that only reopening the app could release. The platform stops the
          service for us here; onDestroy is still the single place the wake lock is given back.
        -->
        <service
            android:name="expo.modules.batilocation.BatiLocationService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="true"/>
    </application>
</manifest>
