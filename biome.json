{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.expo",
      "!**/.tamagui",
      "!**/dist",
      "!**/node_modules",
      "!**/babel.config.js",
      "!**/metro.config.js",
      "!assets",
      "!.claude",
      "!.design-sync",
      "!.ds-sync",
      "!ds-bundle",
      "!.github",
      "!docs/legal/**/*.html",
      "!drizzle"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false
    },
    "globals": ["__DEV__"]
  },
  "plugins": [
    "./.biome/plugins/noRawHexColor.grit",
    "./.biome/plugins/noIdenticalTernaryArms.grit",
    "./.biome/plugins/noDynamicEnvAccess.grit",
    "./.biome/plugins/noJsNetwork.grit",
    "./.biome/plugins/noBareSheetScrollView.grit"
  ],
  "linter": {
    "enabled": true,
    "domains": {
      "react": "all",
      "reactNative": "all",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noVoid": "error",
        "noUselessFragments": "error",
        "noExtraBooleanCast": "error",
        "useLiteralKeys": "error",
        "noForEach": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noConstantCondition": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredVariables": "error",
        "noSelfAssign": "error",
        "noVoidTypeReturn": "error",
        "noUndeclaredDependencies": "error",
        "noReactNativeRawText": {
          "level": "error",
          "options": {
            "skip": [
              "AppButton",
              "AppText",
              "Button",
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "H6",
              "Heading",
              "Label",
              "NButton",
              "NKicker",
              "NKickerQuiet",
              "NMuted",
              "NNum",
              "NText",
              "NTitle",
              "Paragraph",
              "Recitatif",
              "SectionLabel",
              "SizableText",
              "Trait"
            ]
          }
        },
        "useReactNativePlatformComponents": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useTemplate": "error",
        "noParameterAssign": "error",
        "useSingleVarDeclarator": "error",
        "noDefaultExport": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "noReactNativeLiteralColors": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noArrayIndexKey": "error",
        "noDuplicateJsxProps": "error",
        "noAssignInExpressions": "error",
        "noImplicitAnyLet": "error",
        "noRedeclare": "error",
        "useAwait": "warn",
        "noEmptyBlockStatements": "error",
        "noReactNativeDeepImports": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "components/home/**",
        "components/session/**",
        "app/(tabs)/index.tsx",
        "app/session.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "tamagui": {
                    "importNames": ["Text"],
                    "message": "Use AppText (components/common/AppText.tsx): it carries the font-size cap (caps in fontCaps.ts). H1-H6 and Paragraph stay, and a big figure takes maxFontSizeMultiplier={FONT_CAPS.display}."
                  },
                  "react-native": {
                    "importNames": ["Text"],
                    "message": "Use AppText (components/common/AppText.tsx): it carries the font-size cap."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/**", "*.config.ts", "*.config.js"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["components/HomeSettingsMenu.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["components/village/VillageScene.tsx", "db/village.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.md"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "**/__tests__/**",
        "test/node/**",
        "jest.setup.ts"
      ],
      "javascript": {
        "globals": ["jest"]
      },
      "linter": {
        "domains": {
          "test": "all"
        },
        "rules": {
          "style": {
            "useConsistentTestIt": "off"
          },
          "suspicious": {
            "noConsole": "off",
            "noEmptyBlockStatements": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true,
    "defaultBranch": "main"
  }
}
