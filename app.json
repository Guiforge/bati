{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.guiforge.bati",
      "versionCode": 20900,
      "blockedPermissions": ["android.permission.ACCESS_WIFI_STATE"],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "application/json" }]
        }
      ]
    },
    "backgroundColor": "#0B0F19",
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.guiforge.bati",
      "infoPlist": {
        "CFBundleLocalizations": ["en", "fr"]
      }
    },
    "locales": {
      "en": "./locales/ios/en.json",
      "fr": "./locales/ios/fr.json"
    },
    "name": "Bati",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F19",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "fr"],
            "android": ["en", "fr", "de", "es"]
          }
        }
      ],
      "expo-router",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to pick a photo for your hero's avatar, or for an exercise or quest you made. It stays on your device, and leaves it only inside a backup or an encrypted sync you turn on."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Flame",
              "label": "Bati: Flame",
              "description": "Your training flame.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/flame.png"
            },
            {
              "name": "Weekly",
              "label": "Bati: Week",
              "description": "Sessions this week against your oath.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/weekly.png"
            }
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/withAndroidLint",
      "./plugins/withAndroidEdgeToEdgeTheme",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidGradleMemory",
      "./plugins/withAndroidReleaseFlags",
      "./plugins/withAndroidTrimPermissions",
      "./plugins/withAndroidMailtoQuery",
      "./plugins/withAndroidFileIntentScheme",
      "./plugins/withAndroidStaleFileIntent",
      "./plugins/withAndroidReproducibleNative",
      "./plugins/withAndroidLocalAppId",
      "./plugins/withAndroidDebugIcon",
      "./plugins/withAndroidDebugNetworkPermissions",
      "./plugins/withAndroidBackupRules",
      "./plugins/withAndroidNetworkSecurity",
      "./plugins/withAndroidPredictiveBack",
      "./plugins/withAndroidFontScaleConfigChanges",
      "./plugins/withAndroidPngIcons"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "bati",
    "slug": "bati",
    "userInterfaceStyle": "dark",
    "version": "2.9.0",
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    }
  }
}
