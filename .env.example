# Bati Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# App Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_NAME=Bati

# Secrets (use .env.local for actual values)
# API_SECRET=your_secret_here
# DATABASE_URL=your_database_url
# AUTH_TOKEN=your_auth_token



# Black Forest Labs, used by scripts/generate-*.py to render the artwork.
# https://bfl.ai — the FLUX output licence grants to whoever holds the key, so this must be
# our own account rather than an aggregator's. See scripts/lib/flux.py.
BFL_API_KEY=
