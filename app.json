{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.bati",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "userInterfaceStyle": "dark"
    },
    "backgroundColor": "#0B0F19",
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "icon": "./assets/app-icon.png",
    "ios": {
      "bundleIdentifier": "com.anonymous.bati",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["en", "fr"],
        "UIBackgroundModes": ["audio"]
      },
      "supportsTablet": true,
      "userInterfaceStyle": "dark"
    },
    "jsEngine": "hermes",
    "name": "bati",
    "newArchEnabled": true,
    "orientation": "portrait",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F19",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-localization",
      "expo-router"
    ],
    "scheme": "bati",
    "slug": "bati",
    "userInterfaceStyle": "dark",
    "version": "1.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/app-icon.png",
      "output": "static"
    }
  }
}
