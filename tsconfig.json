{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo",
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./*"],
      // view-shot 6 lists its `react-native` condition (raw src/index.tsx, which skipLibCheck
      // cannot skip) before `types`; Expo's customConditions picks the source. Read the built types.
      "react-native-view-shot": ["./node_modules/react-native-view-shot/lib/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // The Node tests have their own dependencies (test/node/package.json) and their own check, in test/node/tsconfig.json.
  "exclude": ["node_modules", ".design-sync", ".ds-sync", "ds-bundle", "test/node"]
}
